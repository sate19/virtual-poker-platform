generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
  CLOSED
}

enum SeatStatus {
  OCCUPIED
  STANDING
}

enum HandPhase {
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  FINISHED
}

enum TournamentStatus {
  DRAFT
  REGISTERING
  PLAYING
  FINISHED
  CANCELLED
}

model User {
  id                   String             @id @default(cuid())
  username             String             @unique
  displayName          String
  passwordHash         String
  role                 UserRole           @default(USER)
  virtualChips         Int                @default(10000)
  isBanned             Boolean            @default(false)
  isAI                 Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lastLoginAt          DateTime?
  stats                UserStats?
  createdRooms         Room[]             @relation("RoomCreator")
  roomSeats            RoomSeat[]
  handHistories        UserHandHistory[]
  chatMessages         ChatMessage[]
  auditLogs            AdminAuditLog[]     @relation("AuditActor")
  chipLedgerEntries    VirtualChipLedger[]
  tournamentEntries    TournamentPlayer[]
}

model UserStats {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalHands           Int      @default(0)
  handsWon             Int      @default(0)
  voluntarilyPutInPot  Int      @default(0)
  showdownCount        Int      @default(0)
  showdownWins         Int      @default(0)
  netVirtualChips      Int      @default(0)
  biggestPotWon        Int      @default(0)
  tournamentsPlayed    Int      @default(0)
  tournamentsWon       Int      @default(0)
  updatedAt            DateTime @updatedAt
}

model Room {
  id                 String        @id @default(cuid())
  name               String
  status             RoomStatus    @default(WAITING)
  maxPlayers         Int           @default(9)
  minPlayersToStart  Int           @default(2)
  smallBlind         Int
  bigBlind           Int
  ante               Int           @default(0)
  minBuyIn           Int
  maxBuyIn           Int
  actionTimeoutSeconds Int         @default(30)
  creatorOnlyStart   Boolean       @default(false)
  allowSpectators    Boolean       @default(true)
  rabbitHunting      Boolean       @default(true)
  deckType            String        @default("standard")
  createdById        String
  createdBy          User          @relation("RoomCreator", fields: [createdById], references: [id])
  seats              RoomSeat[]
  chats              ChatMessage[]
  gameSnapshot       Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  closedAt           DateTime?
  deletedAt          DateTime?
}

model RoomSeat {
  id                 String     @id @default(cuid())
  roomId             String
  room               Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex          Int
  tableChips         Int
  ready              Boolean    @default(false)
  status             SeatStatus @default(OCCUPIED)
  satAt              DateTime   @default(now())
  leftAt             DateTime?

  @@unique([roomId, seatIndex])
  @@unique([roomId, userId])
}

model UserHandHistory {
  id              String    @id @default(cuid())
  handId          String
  roomId          String
  roomName        String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  handNumber      Int
  playerCount     Int
  buttonSeatIndex Int
  deckType        String    @default("standard")
  smallBlind      Int
  bigBlind        Int
  ante            Int
  seatIndex       Int
  holeCards       Json
  communityCards  Json
  startingStack   Int
  endingStack     Int
  netResult       Int
  totalCommitted  Int
  folded          Boolean
  wonAmount       Int
  bestHand        Json?
  potTotal        Int
  result          String
  actions         Json
  opponents       Json?
  startedAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([handId])
}

model ChatMessage {
  id                 String   @id @default(cuid())
  roomId             String
  room               Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message            String
  createdAt          DateTime @default(now())
}

model AdminAuditLog {
  id                 String   @id @default(cuid())
  actorId            String
  actor              User     @relation("AuditActor", fields: [actorId], references: [id])
  action             String
  targetType         String
  targetId           String
  metadata           Json?
  createdAt          DateTime @default(now())
}

model VirtualChipLedger {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta              Int
  reason             String
  roomId             String?
  metadata           Json?
  createdAt          DateTime @default(now())
}

model Tournament {
  id                 String             @id @default(cuid())
  name               String
  status             TournamentStatus   @default(DRAFT)
  maxPlayers         Int                @default(9)
  startingChips      Int                @default(3000)
  blindSchedule      Json
  currentLevel       Int                @default(0)
  handsPerLevel      Int                @default(10)
  winnerUserId       String?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  startedAt          DateTime?
  endedAt            DateTime?
  players            TournamentPlayer[]
}

model TournamentPlayer {
  id                 String      @id @default(cuid())
  tournamentId       String
  tournament         Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seatIndex          Int?
  chips              Int
  finishingPlace     Int?
  eliminatedAt       DateTime?

  @@unique([tournamentId, userId])
}
